{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Peak-a-boo candidate case",
  "type": "object",
  "required": [
    "case_id",
    "pair_id",
    "source_type",
    "condition_eligible",
    "candidate_time",
    "signal_key",
    "hidden_reference_status",
    "hidden_case_category",
    "hidden_disagreement_type",
    "prominence",
    "local_noise",
    "detectability",
    "weber_boundary",
    "weber_margin",
    "stability",
    "parameter_robustness",
    "algorithmic_recommendation",
    "provenance_json",
    "pilot_ready"
  ],
  "properties": {
    "case_id": {"type": "string"},
    "pair_id": {"type": "string"},
    "source_type": {"enum": ["synthetic", "real"]},
    "condition_eligible": {"type": "string"},
    "candidate_time": {"type": "number"},
    "signal_key": {"type": "string"},
    "hidden_reference_status": {"enum": ["supported", "unsupported", "oversegmented"]},
    "hidden_case_category": {"type": "string"},
    "hidden_disagreement_type": {"type": "string"},
    "prominence": {"type": "number", "minimum": 0},
    "local_noise": {"type": "number", "minimum": 0},
    "detectability": {"type": "number", "minimum": 0},
    "weber_boundary": {"type": "number", "minimum": 0},
    "weber_margin": {"type": "number"},
    "stability": {"type": "number", "minimum": 0, "maximum": 1},
    "parameter_robustness": {"type": "number", "minimum": 0, "maximum": 1},
    "overlap_flag": {"type": "boolean"},
    "duplicate_risk": {"enum": ["Low", "Moderate", "High"]},
    "algorithmic_recommendation": {"enum": ["Accept", "Reject", "Defer"]},
    "provenance_json": {"type": "string"},
    "explanation_trial_eligible": {"type": "boolean"},
    "pilot_ready": {"type": "boolean"}
  }
}
